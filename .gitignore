/target/

# Local runtime data (TUCANO_DATA_DIR; the server's default is ./Data, so a
# default `cargo run` never dirties the repo). /data is kept for the older
# local naming.
/Data/
/data/

# Belt-and-braces: the same documents straight in the repo root, should anyone
# ever point TUCANO_DATA_DIR at it. Mirrors the storage layout in AGENTS.md.
/customers/
/entries/
/expenses/
/invoices/
/users/
/categories/
/notifications/
/audit.log
/scheduler.json
/email_reminders.json
/session.key
/secrets.bin
/vault.key
# Local key material for the docker-compose `secrets:` recipe. The directory
# holds operator-supplied keys, so it is ignored as a whole.
/secrets/
/.server.lock
/.tucanotime.lock

# Local editor and scratch artifacts.
*.json.tmp
.DS_Store

# jsdom harness dependencies (gui-test/)
gui-test/node_modules

# Python bytecode from the real-browser gate (gui-test/browser-smoke.py)
__pycache__/
*.pyc
