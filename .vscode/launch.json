{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug server (cargo run)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin",
          "tatu-time"
        ],
        "filter": {
          "name": "tatu-time",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1",
        "TATU_DATA_DIR": "${workspaceFolder}/Data",
        "TATU_PORT": "8080"
      },
      "sourceLanguages": [
        "rust"
      ],
      "preLaunchTask": "cargo build",
      "serverReadyAction": {
        "pattern": "listening on :(\\d+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Debug unit tests (lib)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib"
        ],
        "filter": {
          "name": "tatu-time",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "Debug contract tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--test",
          "contract"
        ],
        "filter": {
          "name": "contract",
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "sourceLanguages": [
        "rust"
      ]
    }
  ]
}